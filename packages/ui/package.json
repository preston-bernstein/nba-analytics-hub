{
  "name": "@nba-analytics-hub/ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nba-analytics-hub/source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "dependencies": {
    "@nba-analytics-hub/games": "0.0.1",
    "@nba-analytics-hub/prediction": "0.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "shadcn": "^3.5.1"
  },
  "nx": {
    "tags": [
      "scope:ui"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "dependsOn": [
          "@nba-analytics-hub/games:build",
          "@nba-analytics-hub/prediction:build"
        ],
        "options": {
          "tsConfig": "packages/ui/tsconfig.lib.json",
          "main": "packages/ui/src/index.ts",
          "outputPath": "packages/ui/dist"
        }
      },
      "lint": {
        "executor": "@nx/eslint:lint",
        "options": {
          "lintFilePatterns": [
            "packages/ui/**/*.ts",
            "packages/ui/**/*.tsx"
          ]
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run",
          "cwd": "packages/ui"
        }
      }
    }
  }
}
