{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "composite": true,
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "paths": {
      "@nba-analytics-hub/types": [
        "../packages/types/dist/src/index.d.ts"
      ],
      "@nba-analytics-hub/domain": [
        "../packages/domain/dist/src/index.d.ts"
      ],
      "@nba-analytics-hub/config": [
        "../packages/config/dist/src/index.d.ts"
      ],
      "@nba-analytics-hub/testing": [
        "../packages/testing/dist/src/index.d.ts"
      ],
      "@nba-analytics-hub/data-access": [
        "../packages/data-access/dist/src/index.d.ts"
      ]
    },
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs",
    "**/*.spec.ts",
    "**/*.test.ts",
    "src/test-utils/**"
  ],
  "references": [
    {
      "path": "../packages/config/tsconfig.lib.json"
    },
    {
      "path": "../packages/testing/tsconfig.lib.json"
    },
    {
      "path": "../packages/events/tsconfig.lib.json"
    },
    {
      "path": "../packages/games/tsconfig.lib.json"
    },
    {
      "path": "../packages/platform/tsconfig.lib.json"
    },
    {
      "path": "../packages/prediction/tsconfig.lib.json"
    }
  ]
}
