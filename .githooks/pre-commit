#!/usr/bin/env bash
# Shared pre-commit hook. Save as .githooks/pre-commit, chmod +x, then run once per clone:
#   git config core.hooksPath .githooks
# Pack: core, rule core-one-gate. CI must run the same script, because a hook can be skipped.
set -euo pipefail
exec bash "$(git rev-parse --show-toplevel)/scripts/core-validate.sh"
